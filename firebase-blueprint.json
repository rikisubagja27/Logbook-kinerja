{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile settings and credentials for the civil servant / employee",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "jabatan": { "type": "string" },
        "statusKepegawaian": { "type": "string" },
        "unitKerja": { "type": "string" },
        "instansiInduk": { "type": "string" },
        "kementerian": { "type": "string" },
        "tempatPenetapan": { "type": "string" },
        "email": { "type": "string" },
        "fotoProfil": { "type": "string" },
        "tandaTanganUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["nama", "nip"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Registered employee roster document in the shared KPS 1 Manoko directory",
      "type": "object",
      "properties": {
        "nama": { "type": "string" },
        "nip": { "type": "string" },
        "jabatan": { "type": "string" },
        "statusKepegawaian": { "type": "string" },
        "unitKerja": { "type": "string" },
        "instansiInduk": { "type": "string" },
        "kementerian": { "type": "string" },
        "tempatPenetapan": { "type": "string" },
        "email": { "type": "string" },
        "fotoProfil": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["nama", "nip"]
    },
    "LogbookEntry": {
      "title": "LogbookEntry",
      "description": "Daily operational performance logbook entry with documentation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "tanggal": { "type": "string" },
        "kehadiran": { "type": "string", "enum": ["WFO", "Sakit", "Cuti"] },
        "waktuMulai": { "type": "string" },
        "waktuSelesai": { "type": "string" },
        "kategori": { "type": "string" },
        "uraianPekerjaan": { "type": "string" },
        "lokasiPekerjaan": { "type": "string" },
        "luasLahan": { "type": "string" },
        "fotoSebelum": { "type": "string" },
        "fotoSesudah": { "type": "string" },
        "suratSakit": { "type": "string" },
        "keterangan": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "tanggal", "kehadiran", "uraianPekerjaan"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Shared directory of registered employees and NIPs in KPS PVT 1 Manoko"
    },
    "/users/{userId}/profile/main": {
      "schema": "UserProfile",
      "description": "Profile document of the authenticated user"
    },
    "/users/{userId}/logbookEntries/{entryId}": {
      "schema": "LogbookEntry",
      "description": "Logbook entries created and managed by the authenticated user"
    }
  }
}
