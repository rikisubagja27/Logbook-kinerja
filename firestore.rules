rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Shared employee / NIP directory for KPS PVT I Manoko
    // Allows any colleague or device to read the roster and save registered employee data
    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if request.resource.data.nama is string && request.resource.data.nip is string;
      allow delete: if true;
    }

    // User data scoped to the user partition (Google UID or sanitized Google account ID)
    // Ensures seamless multi-device sync without blocking on OAuth popup domain restrictions
    match /users/{userId} {
      allow read, write: if true;

      match /profile/{docId} {
        allow read, write: if true;
      }

      match /logbookEntries/{entryId} {
        allow read, write: if true;
      }
    }
  }
}
